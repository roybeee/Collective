# Server-only AES-GCM key (base64 encoded 32 bytes) configured in Sites.
AGENCY_ENCRYPTION_KEY=
# Optional server-side OpenAI key; UI also accepts and encrypts a user key.
OPENAI_API_KEY=

# Private server queue connection (set by deployment, never commit real tokens)
RESEARCH_WORKER_GATE_TOKEN=
RESEARCH_WORKER_SITE_ORIGIN=
