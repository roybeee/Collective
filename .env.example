# Server-only AES-GCM key (base64 encoded 32 bytes) configured in Sites.
AGENCY_ENCRYPTION_KEY=
# Optional server-side OpenAI key; UI also accepts and encrypts a user key.
OPENAI_API_KEY=

# Private server queue connection (set by deployment, never commit real tokens)
RESEARCH_WORKER_GATE_TOKEN=
RESEARCH_WORKER_SITE_ORIGIN=
# Comma-separated authenticated user IDs allowed to download the private installer.
# Empty denies all installer downloads; existing workers and owner revocation still work.
RESEARCH_WORKER_ADMIN_IDS=
# Optional opt-in switches (empty keeps the default: record and warn only).
# enforce: new worker tokens expire after 90 days and rotate online (needs the current installer; see docs/SECURITY-BOUNDARIES.ko.md).
RESEARCH_WORKER_TOKEN_EXPIRY=
# enforce: the app also rejects worker requests whose site gate header does not match (confirm the dispatcher forwards it first).
RESEARCH_WORKER_APP_GATE=
# block: refuse to start deep research when dangerous tools are advertised or the tool check fails (default warn).
RESEARCH_TOOL_POLICY=
