   "parent": "syn-s6-locker-campaign",
   "data": {
    "campaignId": "syn-s6-locker-campaign",
    "campaignVersion": 1,
    "role": "growth",
    "title": "합성 그로스",
    "content": "## 유입 동선\n역 출구 → 배너 → 보관함 → 결제.\n\n## 측정\n가동률을 본다. 대형 칸은 12개라 주말 가동률 80%가 목표다.\n",
    "version": 1,
    "status": "revision",
