+export type RetirableCode={code:string;validFrom:string;retiredOn:string|null};
+export function codeRetireDecision(code:unknown,input:unknown,ctx:CodeRetireContext):RecruitmentDecision<{retiredOn:string}>{
+ return guarded(()=>{
+  const c=ctxOf(ctx);
